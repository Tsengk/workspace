<?xml version="1.0"?>
<package format="2">
  <name>multi_view_stitch</name>
  <version>0.0.1</version>
  <description>Three-camera lateral stitching based on bev-exported Mei camera parameters</description>

  <maintainer email="idriver@example.com">idriver</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>camera_model</depend>

  <build_depend>yaml-cpp</build_depend>
  <build_export_depend>yaml-cpp</build_export_depend>
  <exec_depend>yaml-cpp</exec_depend>
</package>
