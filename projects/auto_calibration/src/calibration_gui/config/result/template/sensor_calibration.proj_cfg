# ====================================================================
# 激光雷达名称列表，根据此列表读取后续标定参数:
lidar_names: [ "front_middle_lidar", "front_left_lidar", "front_right_lidar"] 
# 具体的相机标定参数词条：
# 注意，必须和上面的 lidar_names 中的内容一一对应，否则会读取出错
front_middle_lidar:
  lidar_t: [2.55, 0.0, 1.23] 
  lidar_R: [-0.96, 2.11, 1.04] 
front_left_lidar:
  lidar_t: [1.76, 1.27, 1.30]
  lidar_R: [-1.36, 0.75, 60.55]
front_right_lidar:
  lidar_t: [1.76, -1.27, 1.25]
  lidar_R: [-0.01, -0.87, -58.99]
# ====================================================================


radar_names: [ "front_middle_radar", "front_left_radar", "front_right_radar"] 
# 具体的相机标定参数词条：
# 注意，必须和上面的 lidar_names 中的内容一一对应，否则会读取出错
front_middle_radar:
  radar_t: [2.60, 0.0, 1.14] 
  radar_R: [0.0, 1.10, -0.70] 
front_left_radar:
  radar_t: [1.82, 1.38, 1.19]
  radar_R: [-4.50, -1.20, 60.40]
front_right_radar:
  radar_t: [1.82, -1.38, 1.19]
  radar_R: [-1.80, -4.00, -59.60]
# ====================================================================

