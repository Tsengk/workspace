Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Cone Cloud1
        - /Cone Markers1
        - /Fit Markers1
      Splitter Ratio: 0.600000023841858
    Tree Height: 680
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 1
      Class: rviz/Grid
      Color: 130; 130; 130
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: -0.07
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 0.5
        Min Value: -0.5
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 180; 50
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 180; 50
      Max Intensity: 4096
      Min Color: 100; 50; 0
      Min Intensity: 0
      Name: Cone Cloud
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.019999999552965164
      Style: Points
      Topic: /lidar_yaw1_test/cone_cloud
      Unreliable: false
      Use Fixed Frame: false
      Use rainbow: false
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /lidar_yaw1_test/cone_markers
      Name: Cone Markers
      Namespaces:
        cone_labels: true
        cones: true
      Queue Size: 100
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /lidar_yaw1_test/fit_markers
      Name: Fit Markers
      Namespaces:
        cali_result: true
        fit_line: true
        lidar_origin: true
        pass_fail: true
        scene_title: true
        x_axis_ref: true
      Queue Size: 100
      Value: true

  Enabled: true
  Fixed Frame: lidar
  Global Options:
    Background Color: 25; 25; 30
    Default Light: true
    Fixed Frame: lidar
    Frame Rate: 30

  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select

  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 35
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 10
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.6203981995582581
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.0853981494903564
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
  X: 50
  Y: 50
