Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Global Cones1
        - /Vehicle Poses1
        - /Result Text1
      Splitter Ratio: 0.600000023841858
    Tree Height: 680
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 2
      Class: rviz/Grid
      Color: 100; 100; 100
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /gnss_yaw_test/global_cones
      Name: Global Cones
      Namespaces:
        cone_labels: true
        global_cones: true
      Queue Size: 100
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /gnss_yaw_test/vehicle_poses
      Name: Vehicle Poses
      Namespaces:
        vehicle_arrows: true
        vehicle_labels: true
      Queue Size: 100
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /gnss_yaw_test/result_text
      Name: Result Text
      Namespaces:
        cali_result: true
        pass_fail: true
        scene_title: true
      Queue Size: 100
      Value: true

  Enabled: true
  Fixed Frame: map
  Global Options:
    Background Color: 20; 20; 25
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30

  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select

  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Scale: 30
      Angle: 0
      X: 15
      Y: 5
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz)
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
  X: 50
  Y: 50
