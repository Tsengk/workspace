Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Raw Cloud1
        - /Ground Cloud1
        - /Markers1
      Splitter Ratio: 0.600000023841858
    Tree Height: 680
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Selection
    Name: Selection

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 1
      Class: rviz/Grid
      Color: 130; 130; 130
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: -1.8
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 50; 50
      Max Intensity: 4096
      Min Color: 50; 50; 255
      Min Intensity: 0
      Name: Raw Cloud
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 1
      Size (m): 0.019999999552965164
      Style: Points
      Topic: /lidar_rp_cali/raw_cloud
      Unreliable: false
      Use Fixed Frame: false
      Use rainbow: true
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 0; 220; 50
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Ground Cloud
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.019999999552965164
      Style: Points
      Topic: /lidar_rp_cali/ground_cloud
      Unreliable: false
      Use Fixed Frame: false
      Use rainbow: false
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /lidar_rp_cali/markers
      Name: Markers
      Namespaces:
        cali_result: true
        lidar_origin: true
        pass_fail: true
        plane_normal: true
        plane_rms: true
        plane_surface: true
        scene_title: true
      Queue Size: 100
      Value: true

  Enabled: true
  Fixed Frame: lidar
  Global Options:
    Background Color: 30; 30; 35
    Default Light: true
    Fixed Frame: lidar
    Frame Rate: 30

  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point

  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 28
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 5
        Y: 0
        Z: -1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.5203981995582581
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 2.8853981494903564
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 000000ff00000000fd00000004000000000000015600000336fc0200000001fb0000001200530065006c006500630074006900
    
    6e007400200046006900 6c006500730000000000000001100000009900000000000000000000000000000000000000000700000005000000050000000800000008fc0000000100000001000000010000000a0054006f006f006c00730100000000ffffffff0000000000000000
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1400
  X: 50
  Y: 50
