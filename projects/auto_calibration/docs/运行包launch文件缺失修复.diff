diff --git a/src/calibration_gui/src/config_manager.cpp b/src/calibration_gui/src/config_manager.cpp
index 2f52913..0e4e651 100644
--- a/src/calibration_gui/src/config_manager.cpp
+++ b/src/calibration_gui/src/config_manager.cpp
@@ -5,6 +5,35 @@
 #include <yaml-cpp/yaml.h>
 
 namespace calibration_gui {
+namespace {
+
+bool fileExists(const std::string& path)
+{
+    std::ifstream f(path);
+    return f.good();
+}
+
+std::string resolveLaunchPath(const std::string& config_dir,
+                              const std::string& launch_file)
+{
+    if (launch_file.empty()) return "";
+    if (launch_file[0] == '/') return launch_file;
+
+    const std::string base = config_dir + "/../../";
+    const std::string direct = base + launch_file;
+    if (fileExists(direct)) return direct;
+
+    // 兼容安装空间中 share/<pkg>/launch 的标准布局。
+    static const std::string kSensorDriverPrefix = "sensor_driver/";
+    if (launch_file.compare(0, kSensorDriverPrefix.size(), kSensorDriverPrefix) == 0) {
+        const std::string fallback = base + launch_file.substr(kSensorDriverPrefix.size());
+        if (fileExists(fallback)) return fallback;
+    }
+
+    return direct;
+}
+
+} // namespace
 
 ConfigManager::ConfigManager() {}
 
@@ -406,7 +435,7 @@ std::string ConfigManager::getLidarLaunchFilePath(const std::string& lidar_name)
     if (!loaded_) return "";
     for (const auto& l : config_.lidars) {
         if (l.name == lidar_name && !l.launch_file.empty()) {
-            return configDir() + "/../../" + l.launch_file;
+            return resolveLaunchPath(configDir(), l.launch_file);
         }
     }
     return "";
@@ -417,7 +446,7 @@ std::string ConfigManager::getRadarLaunchFilePath(const std::string& radar_name)
     if (!loaded_) return "";
     for (const auto& r : config_.radars) {
         if (r.name == radar_name && !r.launch_file.empty()) {
-            return configDir() + "/../../" + r.launch_file;
+            return resolveLaunchPath(configDir(), r.launch_file);
         }
     }
     return "";
